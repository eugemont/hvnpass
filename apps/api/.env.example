# Postgres connection string
DATABASE_URL="postgresql://heaven_pass:heaven_pass@localhost:5432/heaven_pass?schema=public"

# HTTP server
PORT=3000

# Secret used to sign auth JWTs (dev-only /auth/dev-token route) and reservation QR codes.
# Generate a strong random value in production, e.g. `openssl rand -hex 32`.
JWT_SECRET="dev-only-change-me"
QR_SIGNING_SECRET="dev-only-change-me-too"

# Shared secret the payment provider must send back on webhook calls (HMAC or static header, provider-dependent).
PAYMENTS_WEBHOOK_SECRET="dev-only-change-me-as-well"

# How often (ms) the in-process expiration job sweeps PENDING reservations past their hold window.
EXPIRATION_JOB_INTERVAL_MS=60000
