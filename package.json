{
  "name": "heaven-pass",
  "private": true,
  "version": "0.1.0",
  "description": "Heaven Pass - plataforma de membresias premium de acceso a fiestas en Punta del Este",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @heaven-pass/api db:generate",
    "db:migrate": "pnpm --filter @heaven-pass/api db:migrate",
    "db:seed": "pnpm --filter @heaven-pass/api db:seed",
    "db:studio": "pnpm --filter @heaven-pass/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
